{
  "schemaVersion": 1,
  "themeApiVersion": 1,
  "id": "github:dragomirfr/cytv-themes:dragomir-green",
  "title": "Dragomir Green",
  "description": "The Dragomir theme with a green glow and green highlights instead of rose.",
  "author": {
    "name": "Dragomir",
    "url": "https://github.com/DragomirFr"
  },
  "themeVersion": "1.0.0",
  "layout": {
