      "width": 96,
      "height": 96
    },
    {
      "id": "icon-inputs-focused",
      "path": "assets/icon-inputs-focused.png",
      "mediaType": "image/png",
      "width": 96,
      "height": 96
    },
    {
      "id": "icon-network",
      "path": "assets/icon-network.png",
      "mediaType": "image/png",
      "width": 96,
      "height": 96
    },
    {
      "id": "icon-network-focused",
      "path": "assets/icon-network-focused.png",
      "mediaType": "image/png",
      "width": 96,
      "height": 96
    },
    {
      "id": "icon-settings",
      "path": "assets/icon-settings.png",
      "mediaType": "image/png",
      "width": 96,
      "height": 96
    },
    {
